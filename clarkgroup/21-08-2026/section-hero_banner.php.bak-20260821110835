<?php
/* =========================================================
   1. PROJECT HERO
   ========================================================= */

/* Background image: ACF hero field -> featured image fallback */
$hero_field_id = get_field( 'cg_project_hero_image', $project_id );
$bg_url = $hero_field_id
	? wp_get_attachment_image_url( $hero_field_id, 'full' )
	: $hero_img_url;

/* TITLE — always guaranteed to have a value.
   IMPORTANT: get_field() can return an empty string "" for a field
   that exists but wasn't filled in. In PHP, "" is falsy, so the ?:
   fallback chain below is safe — but only if get_the_title() is the
   LAST item in the chain, and nothing upstream silently overwrites
   $project_title with "" afterward. */
$custom_title  = get_field( 'cg_project_title', $project_id );
$project_title = ( $custom_title && trim( $custom_title ) !== '' )
	? $custom_title
	: get_the_title( $project_id );

if ( ! $project_title ) {
	$project_title = __( 'Project', 'child-generatepress' );
}

/* Badge / logo mark */
$badge_img_id = get_field( 'cg_project_badge_logo', $project_id );
$badge_url    = $badge_img_id ? wp_get_attachment_image_url( $badge_img_id, 'medium' ) : '';
$badge_text   = get_field( 'cg_project_badge_text', $project_id );

/* Eyebrow line */
$eyebrow = get_field( 'cg_project_eyebrow', $project_id );

/* Excerpt: ACF excerpt -> native excerpt -> trimmed content */
$excerpt_field = get_field( 'cg_project_excerpt', $project_id );
if ( $excerpt_field ) {
	$project_ex = wp_strip_all_tags( $excerpt_field );
} elseif ( has_excerpt( $project_id ) ) {
	$project_ex = wp_strip_all_tags( get_the_excerpt( $project_id ) );
} else {
	$project_ex = wp_trim_words( wp_strip_all_tags( get_the_content( '', false, $project_id ) ), 28, '…' );
}

/* Status pill */
$status_badge = get_field( 'cg_project_status_badge', $project_id );

/* Buttons */
$btn1_text = get_field( 'cg_project_button_text', $project_id );
$btn1_link = get_field( 'cg_project_button_link', $project_id );
$btn2_text = get_field( 'cg_project_button_2_text', $project_id );
$btn2_link = get_field( 'cg_project_button_2_link', $project_id );

/* Meta bar */
$loc      = get_field( 'cg_project_location', $project_id );
$date     = get_field( 'cg_project_date', $project_id );
$features = get_field( 'cg_project_features', $project_id );
$fb       = get_field( 'cg_project_facebook_link', $project_id );
?>

<section class="cg-single-project__hero"
	<?php if ( $bg_url ) : ?>
		style="background-image:url('<?php echo esc_url( $bg_url ); ?>')"
	<?php endif; ?>>

	<div class="cg-single-project__hero-overlay" aria-hidden="true"></div>

	<div class="cg-single-project__hero-inner">

		<?php if ( $badge_url || $badge_text ) : ?>
			<div class="cg-single-project__badge-logo">
				<?php if ( $badge_url ) : ?>
					<img src="<?php echo esc_url( $badge_url ); ?>" alt="<?php echo esc_attr( $project_title ); ?>" />
				<?php endif; ?>
				<?php if ( $badge_text ) : ?>
					<span><?php echo esc_html( $badge_text ); ?></span>
				<?php endif; ?>
			</div>
		<?php endif; ?>

		<?php if ( $eyebrow ) : ?>
			<p class="cg-single-project__eyebrow"><?php echo esc_html( $eyebrow ); ?></p>
		<?php endif; ?>

		<?php if ( $status_badge ) : ?>
			<span class="cg-single-project__status"><?php echo esc_html( $status_badge ); ?></span>
		<?php endif; ?>

		<h1 class="cg-single-project__title"><?php echo esc_html( $project_title ); ?></h1>

		<?php if ( $project_ex ) : ?>
			<p class="cg-single-project__excerpt"><?php echo esc_html( $project_ex ); ?></p>
		<?php endif; ?>

		<?php if ( ( $btn1_text && $btn1_link ) || ( $btn2_text && $btn2_link ) ) : ?>
			<div class="cg-single-project__buttons">
				<?php if ( $btn1_text && $btn1_link ) : ?>
					<a class="button" href="<?php echo esc_url( $btn1_link['url'] ); ?>"
						<?php echo ! empty( $btn1_link['target'] ) ? ' target="' . esc_attr( $btn1_link['target'] ) . '"' : ''; ?>>
						<?php echo esc_html( $btn1_text ); ?> →
					</a>
				<?php endif; ?>

				<?php if ( $btn2_text && $btn2_link ) : ?>
					<a class="button button--outline" href="<?php echo esc_url( $btn2_link['url'] ); ?>"
						<?php echo ! empty( $btn2_link['target'] ) ? ' target="' . esc_attr( $btn2_link['target'] ) . '"' : ''; ?>>
						<?php echo esc_html( $btn2_text ); ?> →
					</a>
				<?php endif; ?>
			</div>
		<?php endif; ?>

	</div>

	<?php if ( $loc || $date || $features || $fb ) : ?>
	<div class="cg-single-project__meta-bar">
		<?php if ( $loc ) : ?>
			<span class="cg-single-project__meta-item cg-single-project__meta-item--location">
				<strong><?php esc_html_e( 'Location', 'child-generatepress' ); ?></strong>
				<?php echo esc_html( $loc ); ?>
			</span>
		<?php endif; ?>

		<?php if ( $date ) : ?>
			<span class="cg-single-project__meta-item cg-single-project__meta-item--date">
				<strong><?php esc_html_e( 'Date', 'child-generatepress' ); ?></strong>
				<?php echo esc_html( $date ); ?>
			</span>
		<?php endif; ?>

		<?php if ( $features ) : ?>
			<span class="cg-single-project__meta-item cg-single-project__meta-item--features">
				<strong><?php esc_html_e( 'Features', 'child-generatepress' ); ?></strong>
				<?php echo esc_html( $features ); ?>
			</span>
		<?php endif; ?>

		<div class="cg-single-project__meta-social">
			<a href="mailto:<?php echo esc_attr( get_bloginfo( 'admin_email' ) ); ?>" aria-label="Email">
				<span class="dashicons dashicons-email"></span>
			</a>
			<?php if ( $fb ) : ?>
				<a href="<?php echo esc_url( $fb ); ?>" target="_blank" rel="noopener" aria-label="Facebook">
					<span class="dashicons dashicons-facebook"></span>
				</a>
			<?php endif; ?>
		</div>
	</div>
	<?php endif; ?>

</section>